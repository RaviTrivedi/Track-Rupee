NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Comma-separated browser origins, without paths or trailing slashes.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Local example only. URL-encode special characters in usernames/passwords.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trackrupee?schema=public

# Generate a random secret (see docs/auth.md); never commit a real signing key.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Development seed only. Supply your own credentials; no built-in demo password.
SEED_DEMO_NAME=TrackRupee Demo
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
