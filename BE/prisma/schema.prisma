generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CASH
  BANK
  CARD
  WALLET
}

enum CategoryType {
  INCOME
  EXPENSE
}

/// Existing profiles without a password cannot log in until credentials are provisioned.
model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(254)
  name         String?       @db.VarChar(100)
  passwordHash String?       @db.VarChar(60)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  refreshTokens RefreshToken[]
}

/// Rotation retains revoked ancestors to detect replay within each device session.
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.Char(64)
  userId    String   @db.Uuid
  familyId  String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

/// Manual INR account; future transaction writes must update balance atomically.
model Account {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  name           String        @db.VarChar(100)
  type           AccountType
  currency       String        @default("INR") @db.Char(3)
  openingBalance Decimal       @default(0) @db.Decimal(18, 2)
  balance        Decimal       @default(0) @db.Decimal(18, 2)
  isArchived     Boolean       @default(false)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions   Transaction[]

  // Composite keys let foreign keys enforce that related records share an owner.
  @@unique([id, userId])
  @@index([userId, isArchived])
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  name         String        @db.VarChar(100)
  type         CategoryType
  isDefault    Boolean       @default(false)
  icon         String?       @db.VarChar(50)
  color        String?       @db.VarChar(7)
  isArchived   Boolean       @default(false)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([id, userId])
  @@unique([userId, type, name])
}

/// Store positive amounts; type determines whether money enters or leaves an account.
model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  accountId   String          @db.Uuid
  categoryId  String          @db.Uuid
  type        TransactionType
  amount      Decimal         @db.Decimal(18, 2)
  description String?         @db.VarChar(500)
  occurredAt  DateTime        @default(now()) @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  account     Account         @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  category    Category        @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, occurredAt, id])
  @@index([accountId, userId, occurredAt])
  @@index([categoryId, userId, occurredAt])
}

/// INR expense-category limit for one Asia/Kolkata calendar month.
model Budget {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  categoryId String   @db.Uuid
  amount     Decimal  @db.Decimal(18, 2)
  month      Int
  year       Int
  currency   String   @default("INR") @db.Char(3)
  startsAt   DateTime @db.Timestamptz(3)
  endsAt     DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  category   Category @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
}
